# ─── Server ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── Telegram Bot (AI Auto-Push) ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
OWNER_CHAT_ID=your_chat_id_here

# ─── Alpaca API (Live Crypto Feed) ────────────────────────────────────────
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_PAPER_TRADING=true

# ─── Deriv API (OTC Forex Feed) ───────────────────────────────────────────
DERIV_APP_ID=your_deriv_app_id
DERIV_API_TOKEN=your_deriv_token

# ─── Pocket Option Broker (Auto-Execute) ─────────────────────────────────
POCKET_OPTION_EMAIL=your_email@example.com
POCKET_OPTION_PASSWORD=your_password

# ─── IQ Option Broker (Auto-Execute) ──────────────────────────────────────
IQ_OPTION_EMAIL=your_email@example.com
IQ_OPTION_PASSWORD=your_password

# ─── Twelve Data API (Fallback Price Data) ───────────────────────────────
TWELVE_DATA_KEY=your_twelve_data_key

# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_PATH=./data/trading.db

# ─── Signal Engine Settings ────────────────────────────────────────────────
MIN_CONFIDENCE=85
MAX_SIGNALS_PER_CYCLE=2
LIVE_SIGNALS_ONLY=false
ACTIVE_HOURS_START=06:00
ACTIVE_HOURS_END=22:00
DAILY_LOSS_LIMIT=15

# ─── Session Scheduler ────────────────────────────────────────────────────
SESSION_FILTER_ENABLED=true
MAX_DAILY_SIGNALS=20
